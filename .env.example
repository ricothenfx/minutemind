# Environment for the serverless function (/api/extract).
# These are SERVER-side secrets — never prefix them with VITE_ and never ship them to the browser.

# ── Real LLM (any OpenAI-compatible API) ─────────────────────────────
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Examples for other providers (just swap the values):
#   OpenRouter → https://openrouter.ai/api/v1
#   Groq       → https://api.groq.com/openai/v1
#   Ollama     → http://localhost:11434/v1

# ── Offline demo mode ───────────────────────────────────────────────
# Set to true to run without any API key: /api/extract returns a
# pre-baked extraction of the sample transcript instead of calling an LLM.
MOCK_MODE=false
